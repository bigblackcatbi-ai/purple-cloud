# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth web application credentials (server-only except client ID is used by the server)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/google-drive/callback

# Generate with: openssl rand -base64 32
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
